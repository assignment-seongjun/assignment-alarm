MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=assignment_alarm
MYSQL_USER=assignment_user
MYSQL_PASSWORD=change-this-db-password
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
TRUST_PROXY=false
AUTH_RATE_MAX_TRACKED_CLIENTS=5000
ASSIGNMENT_IMAGE_RATE_LIMIT=10
ASSIGNMENT_IMAGE_RATE_WINDOW_MS=600000
ASSIGNMENT_WRITE_RATE_LIMIT=20
ASSIGNMENT_WRITE_RATE_WINDOW_MS=600000
GOOGLE_CLIENT_ID=
# AI 챗봇 코드는 주석으로 보존되어 있으며 키를 넣어도 활성화되지 않습니다.
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_GOOGLE_EMAILS=
ADMIN_EXCLUDED_GOOGLE_EMAILS=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_GRADE=1
ADMIN_CLASS=1

# 운영 환경에서 실제 HTTPS 주소를 설정하세요.
APP_ORIGIN=http://localhost:3000
PORT=3000
# Aiven 같은 원격 MySQL은 검증된 TLS 연결을 사용합니다.
DB_SSL=false
# Aiven에서 받은 CA PEM 내용 (호스팅 환경 변수에 전체 내용 입력)
DB_SSL_CA=
# 영구 디스크가 없는 호스팅에서는 false. 기존 첨부파일은 별도 백업 필요.
ENABLE_ASSIGNMENT_IMAGE_UPLOADS=true
# 영구 볼륨이 있으면 이미지 저장 경로를 지정할 수 있습니다.
ASSIGNMENT_IMAGE_DIR=

# 이미지 전체 저장 한도(MB), 개별 이미지 최대 4MB
ASSIGNMENT_IMAGE_MAX_STORAGE_MB=512
